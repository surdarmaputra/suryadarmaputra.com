{
  "name": "v3",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "astro check",
    "commitlint": "commitlint",
    "generate": "bun run generate:articles && bun run generate:projects",
    "generate:articles": "bun scripts/fetch-articles.ts",
    "generate:projects": "bun scripts/fetch-projects.ts",
    "test": "bun run test:component && bun run test:e2e",
    "test:seed": "bun tests/fixtures/seed-generated-data.ts",
    "test:component": "vitest run",
    "test:component:watch": "vitest",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:ui": "playwright test --project=e2e --ui",
    "test:screenshots": "playwright test --project=screenshots"
  },
  "dependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.64",
    "@notionhq/client": "^2.2.15",
    "@tailwindcss/vite": "^4.1.18",
    "@types/lodash": "^4.17.21",
    "astro": "^5.16.6",
    "astro-icon": "^1.1.5",
    "canvas": "^3.0.0-rc3",
    "dotenv": "^16.4.7",
    "image-js": "^0.35.6",
    "lodash": "^4.17.21",
    "reading-time": "^1.5.0",
    "undici": "^7.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.3.10",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@playwright/test": "^1.63.0",
    "daisyui": "^5.5.14",
    "lefthook": "^2.0.13",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
