---
/**
 * Test-only gallery rendering every supported Notion block in isolation.
 *
 * Injected as `/__test/notion-blocks` only when ENABLE_TEST_ROUTES=true, so it
 * never ships to production. Used by the e2e suite and by
 * `bun run test:screenshots` to capture one PNG per block renderer.
 */
import BlocksRenderer from "../../src/modules/core/libs/notion/blocks-renderer.astro";
import "../../src/modules/core/styles/global.css";
import { blockGallery, IMAGE_BASE_PATH } from "../fixtures/notion-blocks";
---

<!doctype html>
<html lang="en" data-theme="cmyk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Notion block gallery</title>
  </head>
  <body class="font-sans bg-base-100">
    <main class="container max-w-3xl mx-auto px-4 py-8">
      <h1 class="sr-only">Notion block gallery</h1>
      {blockGallery.map(({ name, blocks }) => (
        <section aria-label={name} data-block={name} class="my-8">
          <BlocksRenderer blocks={blocks} imageBasePath={IMAGE_BASE_PATH} />
        </section>
      ))}
    </main>
  </body>
</html>
