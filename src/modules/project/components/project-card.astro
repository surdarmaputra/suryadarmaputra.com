---
import Badge from "../../core/components/base/badge.astro";
import Button from "../../core/components/base/button.astro";
import Card from "../../core/components/base/card.astro";

interface Props {
  thumbnail?: string;
  title: string;
  description: string;
  learnMoreLink?: string;
  previewLink?: string;
  categories?: string[];
}

const { thumbnail, title, description, learnMoreLink, previewLink, categories } = Astro.props;
---

<Card
  title={title}
  class="hover-lift h-full flex flex-col group/project-card transition-all duration-300 text-sm md:text-base"
  bodyClass="flex-grow flex flex-col min-h-0 p-3 md:p-6"
  titleClass="font-display text-sm md:text-2xl leading-tight line-clamp-2"
>
  {thumbnail && (
    <figure slot="header" class="aspect-video overflow-hidden rounded-none">
      <img
        src={thumbnail}
        alt={`${title} thumbnail`}
        class="w-full h-full object-cover transition-transform duration-300 group-hover/project-card:scale-110"
        loading="lazy"
      />
    </figure>
  )}
  {categories && categories.length > 0 && (
    <div slot="after-title" class="mb-2 md:mb-3 flex flex-wrap gap-2">
      {categories.map((category, index) => (
        <Badge variant="neutral" style="outline" itemIndex={index} size="xs" class="md:badge-sm">
          {category}
        </Badge>
      ))}
    </div>
  )}
  <p class="text-xs md:text-base text-base-content/80 mb-3 md:mb-4 line-clamp-5">{description}</p>
  <div slot="actions" class="card-actions flex-col-reverse md:flex-row md:justify-end gap-2">
    {previewLink && (
      <Button
        href={previewLink}
        target="_blank"
        variant="outline"
        size="xs"
        class="hover-scale w-full md:w-auto md:btn-sm"
        aria-label={`Preview ${title} project`}
      >
        Preview
      </Button>
    )}
    {learnMoreLink && (
      <Button
        href={learnMoreLink}
        variant="primary"
        size="xs"
        class="hover-scale w-full md:w-auto md:btn-sm"
        aria-label={`Learn more about ${title} project`}
      >
        Learn More
      </Button>
    )}
  </div>
</Card>

