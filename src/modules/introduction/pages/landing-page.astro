---
import ArticleListSection from "../../article/components/article-list-section.astro";
import { getArticles } from "../../article/services/article-service";
import PageLayout from "../../core/components/layouts/page-layout.astro";
import { PERSONAL, SOCIAL_LINKS } from "../../core/constants";
import ProjectCarouselSection from "../../project/components/project-carousel-section.astro";
import { getProjectsByCompany } from "../../project/services/project-service";
import { sortProjectsForShowcase } from "../../project/utils/project-utils";
import ExperienceJourneySection from "../components/experience-journey-section.astro";
import HeroSection from "../components/hero-section.astro";
import SocialLinksSection from "../components/social-links-section.astro";
import WorkExperienceSection from "../components/work-experience-section.astro";

// Personal projects: highlighted first, then newest
const personalProjects = await getProjectsByCompany("personal");
const projects = sortProjectsForShowcase(personalProjects).slice(0, 6);

// Latest articles only; the full list lives on /articles
const articles = (await getArticles()).slice(0, 3);

const currentPath = Astro.url.pathname;

const personJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: PERSONAL.NAME,
  jobTitle: "Fullstack Software Engineer",
  description: PERSONAL.TITLE,
  url: "https://suryadarmaputra.com",
  sameAs: Object.values(SOCIAL_LINKS),
});
---

<PageLayout
  title="Fullstack Software Engineer"
  description="Surya Darma Putra, fullstack software engineer. Projects, open source work and writing about building web products."
  currentPath={currentPath}
>
  <script type="application/ld+json" slot="head" set:html={personJsonLd} />
  <!-- Handwritten font for the hero illustration labels, subset to the glyphs used -->
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&text=%20%26/ACDIPacdefinrst&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  />
  <HeroSection />

  <div class="section-reveal">
    <ProjectCarouselSection projects={projects} />
  </div>

  <div class="section-reveal">
    <ArticleListSection articles={articles} title="Latest Writing" showViewAll={true} />
  </div>

  <div class="section-reveal">
    <ExperienceJourneySection />
  </div>

  <div class="section-reveal">
    <WorkExperienceSection />
  </div>

  <div class="section-reveal">
    <SocialLinksSection />
  </div>
</PageLayout>

<script>
  import { initArticleListItemScrollReveal } from "../../article/utils/ui-utils";
  import { initAfterNavigation } from "../../core/utils/ui-utils";
  
  // Smooth scroll for anchor links
  function initSmoothScroll() {
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        const href = anchor.getAttribute('href');
        if (href && href !== '#') {
          const target = document.querySelector(href);
          if (target) {
            e.preventDefault();
            const headerOffset = 80;
            const elementPosition = target.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
            
            window.scrollTo({
              top: offsetPosition,
              behavior: 'smooth',
            });
          }
        }
      });
    });
  }
  
  initAfterNavigation(() => {
    initArticleListItemScrollReveal();
    initSmoothScroll();
  });
</script>
