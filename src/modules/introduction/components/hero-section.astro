---
import Button from "../../core/components/base/button.astro";
import Icon from "../../core/components/base/icon.astro";
import Ornament from "../../core/components/base/ornament.astro";
import { PERSONAL, SOCIAL_LINKS } from "../../core/constants";
import HeroStack from "./hero-stack.astro";

const skills = PERSONAL.TITLE;
const [nickname, ...restOfName] = PERSONAL.NAME.split(" ");
const linkedinUrl = SOCIAL_LINKS.LINKEDIN;
const githubUrl = SOCIAL_LINKS.GITHUB;
---

<section
  class="relative overflow-hidden pt-12 pb-20 md:pt-20 lg:min-h-[calc(100vh-72px)] lg:flex lg:items-center"
  aria-label="Hero section"
>
  <Ornament variant="circle" size="md" color="accent" position="top-left" />
  <Ornament variant="dots" size="md" color="primary" position="bottom-right" />

  <div
    class="container-z grid items-center gap-24 lg:gap-10 lg:grid-cols-[1.5fr_1fr]"
  >
    <div class="text-center lg:text-left">
      <h1 class="font-bold font-display mb-5 leading-tight">
        <span class="block font-hand font-semibold text-2xl md:text-3xl">
          <span class="inline-block animate-wave">👋</span> Hello there, I'm
        </span>
        <span class="block whitespace-nowrap tracking-tight text-[2rem] sm:text-5xl md:text-6xl lg:text-5xl mt-1">
          <span class="relative inline-block">
            {nickname}
            <svg
              class="hero-underline absolute left-0 -bottom-[0.18em] w-full h-[0.3em] text-primary"
              viewBox="0 0 200 24"
              preserveAspectRatio="none"
              fill="none"
              aria-hidden="true"
            >
              <path d="M4 15 C 50 7, 120 5, 196 11"></path>
              <path d="M14 20 C 70 14, 130 13, 186 17"></path>
            </svg>
          </span>
          {restOfName.join(" ")}
        </span>
      </h1>
      <p
        class="text-lg md:text-xl text-base-content/80 max-w-xl mx-auto lg:mx-0 leading-snug mb-10 animate-fade-in-up"
      >
        {skills}
      </p>

      <div
        class="flex flex-wrap items-center justify-center lg:justify-start gap-4 animate-fade-in-up animate-delay-200"
      >
        <Button href="#projects" variant="primary" class="hover-scale px-6">
          View my work
          <span class="hero-cta-icon inline-flex overflow-hidden" aria-hidden="true">
            <Icon name="heroicons:arrow-down" size="w-5 h-5" />
          </span>
        </Button>
        <Button
          href={linkedinUrl}
          variant="outline"
          circle={true}
          class="hover-scale"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn profile"
        >
          <Icon name="simple-icons:linkedin" size="w-6 h-6" />
        </Button>
        <Button
          href={githubUrl}
          variant="outline"
          circle={true}
          class="hover-scale"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile"
        >
          <Icon name="simple-icons:github" size="w-6 h-6" />
        </Button>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-[250px] md:max-w-[320px] lg:max-w-none aspect-square lg:aspect-[6/5]">
      <HeroStack />
    </div>
  </div>
</section>


<style>
  .hero-underline path {
    stroke: currentColor;
    stroke-linecap: round;
    stroke-dasharray: 220;
    stroke-dashoffset: 220;
    animation: hero-underline-draw 0.7s ease-out 0.4s forwards;
  }

  .hero-underline path:first-child {
    stroke-width: 6;
  }

  .hero-underline path:last-child {
    stroke-width: 3.5;
    animation-delay: 0.75s;
  }

  @keyframes hero-underline-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .hero-cta-icon :global(svg) {
    animation: hero-cta-arrow 2.4s ease-in-out infinite;
  }

  @keyframes hero-cta-arrow {
    0%,
    55% {
      transform: translateY(0);
      opacity: 1;
    }
    75% {
      transform: translateY(110%);
      opacity: 0;
    }
    75.01% {
      transform: translateY(-110%);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cta-icon :global(svg) {
      animation: none;
    }

    .hero-underline path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
