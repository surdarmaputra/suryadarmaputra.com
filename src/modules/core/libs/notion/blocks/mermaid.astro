---
import { Code as AstroCode } from "astro:components";
import { concatPlainTexts } from "../renderer-utils";
import type { BlockWithChildren } from "../types";

interface Props {
  block: BlockWithChildren["block"];
}

const { block } = Astro.props;

if (!("type" in block) || block.type !== "code") {
  return null;
}

// biome-ignore lint/suspicious/noExplicitAny: expected
const codeBlock = (block as any).code;
// biome-ignore lint/suspicious/noExplicitAny: expected
const richTexts = (codeBlock?.rich_text || []) as any[];
const diagramCode = concatPlainTexts(richTexts);
---

<div class="my-2 md:my-4 rounded-xl border border-base-300 bg-base-200 overflow-hidden" data-mermaid-wrapper data-code={diagramCode}>
  <div class="flex gap-1 px-3 py-2 items-center border-b border-base-300">
    <button class="btn btn-xs btn-neutral" data-view="diagram" data-active="true">Diagram</button>
    <button class="btn btn-xs btn-ghost" data-view="code">Code</button>
    <button class="btn btn-xs btn-ghost" data-view="both">Both</button>
    <button class="btn btn-xs btn-ghost ml-auto" data-copy title="Copy mermaid syntax">
      <span data-copy-label>Copy</span>
    </button>
  </div>

  <div data-panel="diagram" class="p-4">
    <div class="flex justify-center overflow-x-auto">
      <pre class="mermaid">{diagramCode}</pre>
    </div>
  </div>

  <div data-panel="code" hidden>
    <AstroCode
      lang="text"
      code={diagramCode}
      class="!rounded-none !border-0 !shadow-none"
      theme="aurora-x"
    />
  </div>
</div>

<script>
  import mermaid from "mermaid";
  import { initAfterNavigation } from "../../../utils/ui-utils";

  function initMermaid() {
    mermaid.initialize({ startOnLoad: false });
    mermaid.run({ querySelector: ".mermaid" });

    document.querySelectorAll("[data-mermaid-wrapper]").forEach((wrapper) => {
      const copyBtn = wrapper.querySelector("button[data-copy]") as HTMLElement | null;
      if (copyBtn) {
        copyBtn.addEventListener("click", async () => {
          const code = (wrapper as HTMLElement).dataset.code ?? "";
          await navigator.clipboard.writeText(code);
          const label = copyBtn.querySelector("[data-copy-label]");
          if (label) {
            label.textContent = "Copied!";
            setTimeout(() => { label.textContent = "Copy"; }, 2000);
          }
        });
      }

      wrapper.querySelectorAll("button[data-view]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const view = (btn as HTMLElement).dataset.view;
          const diagramPanel = wrapper.querySelector('[data-panel="diagram"]') as HTMLElement | null;
          const codePanel = wrapper.querySelector('[data-panel="code"]') as HTMLElement | null;

          wrapper.querySelectorAll("button[data-view]").forEach((b) => {
            (b as HTMLElement).dataset.active = "false";
            b.classList.replace("btn-neutral", "btn-ghost");
          });
          (btn as HTMLElement).dataset.active = "true";
          btn.classList.replace("btn-ghost", "btn-neutral");

          if (diagramPanel) diagramPanel.hidden = view === "code";
          if (codePanel) codePanel.hidden = view !== "code" && view !== "both";
        });
      });
    });
  }

  initAfterNavigation(initMermaid);
</script>
